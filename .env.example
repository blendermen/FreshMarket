# Copy to apps/api/.env and apps/web/.env.local

# --- API (apps/api/.env) ---
DATABASE_URL="postgresql://freshmarket:freshmarket@localhost:5432/freshmarket?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-min-32-characters-long"
JWT_REFRESH_SECRET="dev-refresh-secret-min-32-characters-long"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="freshmarket"
MINIO_PUBLIC_URL="http://localhost:9000/freshmarket"
CORS_ORIGIN="http://localhost:3000"
PORT=4000
NOMINATIM_USER_AGENT="FreshMarket/1.0 (dev@localhost)"

# --- Web (apps/web/.env.local) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-nextauth-secret-min-32-characters-long"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_API_URL="http://localhost:4000/v1"
