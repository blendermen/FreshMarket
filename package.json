{
  "name": "freshmarket",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "pnpm --filter @freshmarket/api exec prisma generate",
    "db:migrate": "pnpm --filter @freshmarket/api exec prisma migrate dev",
    "db:push": "pnpm --filter @freshmarket/api exec prisma db push",
    "db:studio": "pnpm --filter @freshmarket/api exec prisma studio",
    "db:seed": "pnpm --filter @freshmarket/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
